# Chave de API do Gemini. Crie no Google AI Studio (https://aistudio.google.com/api-keys)
# usando o "Nível gratuito" de faturamento. Passo a passo no README.
GOOGLE_API_KEY="AQ.SuaChaveDoAiStudioAqui"

# Modelo do Gemini usado para responder o quiz.
# Opcional: sem esta variável a automação usa gemini-3.5-flash-lite, o modelo mais leve.
GEMINI_MODEL="gemini-3.5-flash-lite"

# Token do bot do Telegram que receberá o link e as notificações.
# Obtenha criando um bot no @BotFather. Passo a passo no README.
TELEGRAM_BOT_TOKEN="1234567890:SeuTokenDoBotFatherAqui"

# Sua ID numérica do Telegram. Obtenha mandando /start para o @idbot.
# Somente dígitos, sem @ e sem #. Passo a passo no README.
TELEGRAM_USER_ID="1234567890"

# Dados estáticos dos formulários, em uma única linha.
# Complete com seu nome, matrícula e cidade.
DSC_PROFILE_JSON={"fullName":"SEU NOME","employeeId":"SUA MATRÍCULA","city":"SUA CIDADE","employmentType":"Parceira","supplier":"ELINSA ELETROTÉCNICA INDUSTRIAL E NAVAL DO BRASIL LTDA","region":"NORDESTE","manager":"JANILSON SAMPAIO DE OLIVEIRA","workArea":"Administrativo (Escritório) – apoio, análise e suporte aos processos"}
